JARVIS_API_TOKEN=McXeh2KyZg5pHaI5N5u3VJL7bc9vXsS1KVwi0WCSwDA
JARVIS_CHAT_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
JARVIS_CONTEXT_LENGTH=2048
JARVIS_OUTPUT_TOKENS=384
JARVIS_CONCURRENCY=1
JARVIS_RESPONSE_TIMEOUT=120s
JARVIS_KEEP_ALIVE=30s
