# Future RAG recommendation; not used in Phase 1:
# JARVIS_EMBEDDING_MODEL=all-minilm:22m

# Dedicated database; keep actual credentials only in the ignored .env file.
JARVIS_DB_URL=jdbc:postgresql://127.0.0.1:5432/jarvis
JARVIS_DB_USER=postgres
JARVIS_DB_PASSWORD=admin

# Local mode needs no token. Set token mode only if desired.
JARVIS_AUTH_MODE=local
